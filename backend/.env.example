# HTTP server
LISTEN_ADDR=127.0.0.1:8080
COOKIE_SECURE=false

# Local sessions
SESSION_TTL_SECONDS=3600

# LDAP
LDAP_URL=ldap://ldap.example
LDAP_GSSAPI_HOST=ldap.example
LDAP_AUTH_SEARCH_BASE_DN=DC=main,DC=sgu,DC=ru
LDAP_USERS_CONTAINER_DN=OU=groups,DC=main,DC=sgu,DC=ru
LDAP_CSIT_ADMINS_GROUP_DN=CN=csit_admins,OU=groups,DC=main,DC=sgu,DC=ru
# Принудительно требовать смену временного пароля при первом входе.
LDAP_FORCE_PASSWORD_CHANGE=true

# Kerberos principal: <identifier>@KERBEROS_REALM.
KERBEROS_REALM=MAIN.SGU.RU
# Локальный закрытый каталог (0700) для персональных FILE ccache (сами файлы — 0600).
# В production можно использовать /run/ad-provisioner/krb5 с владельцем backend-процесса.
KERBEROS_CCACHE_DIR=.kerberos-cache

# Generated result files
RESULT_OUTPUT_DIR=output

# Соответствие номеров учебных групп названиям LDAP-групп
GROUPS_CONFIG_PATH=groups.toml

# Temporary student passwords
PASSWORD_SALT=replace-with-a-random-secret

# SMTP
SMTP_HOST=smtp.example.edu
SMTP_PORT=587
SMTP_SECURITY=starttls
SMTP_USERNAME=admission@example.edu
SMTP_PASSWORD=replace-with-smtp-password
SMTP_FROM_ADDRESS=admission@example.edu
SMTP_FROM_NAME=Приёмная комиссия
SMTP_SUBJECT=Данные вашей учётной записи
SMTP_MAX_CONCURRENT=5
SMTP_TIMEOUT_SECONDS=30
