# HTTP server
LISTEN_ADDR=127.0.0.1:8080
COOKIE_SECURE=false

# Local sessions
SESSION_TTL_SECONDS=3600

# LDAP
LDAP_URL=ldap://ldap.example
# TODO: replace both values with the confirmed directory layout.
LDAP_USER_BIND_DN_SUFFIX=OU=Users,DC=main,DC=sgu,DC=ru
LDAP_AUTH_SEARCH_BASE_DN=DC=main,DC=sgu,DC=ru
LDAP_SERVICE_BIND_DN=CN=service,OU=Service\ Accounts,DC=main,DC=sgu,DC=ru
LDAP_SERVICE_BIND_PASSWORD=replace-me
LDAP_USERS_CONTAINER_DN=OU=groups,OU=КНиИТ,OU=Факультеты,DC=main,DC=sgu,DC=ru
LDAP_CSIT_ADMINS_GROUP_DN=CN=csit_admins,OU=groups,DC=main,DC=sgu,DC=ru

# Generated result files
RESULT_OUTPUT_DIR=output
RESULT_TTL_SECONDS=86400

# Temporary student passwords
PASSWORD_SALT=replace-with-a-random-secret
